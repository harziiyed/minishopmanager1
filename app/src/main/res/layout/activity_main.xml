<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F1F5EE">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MiniShop Manager"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#28543C"
        android:gravity="center"
        android:padding="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Bienvenue dans votre boutique !"
        android:textSize="16sp"
        android:textColor="#607568"
        android:gravity="center"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Suivant"
        android:textColor="#FFFFFF"
        android:backgroundTint="#28543C" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notre catalogue"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#28543C"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        android:id="@+id/tvCatalogTitle"
        android:visibility="gone"
        />

    <ListView
        android:id="@+id/listViewProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE7D8"
        android:dividerHeight="8dp"
        android:clipToPadding="false"
        android:visibility="gone" />


</LinearLayout>
