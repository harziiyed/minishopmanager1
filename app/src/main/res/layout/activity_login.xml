
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#F1F5EE">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MiniShop Manager"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#28543C"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connectez-vous à votre boutique"
        android:textSize="16sp"
        android:textColor="#607568"
        android:gravity="center"
        android:paddingBottom="24dp" />

    <EditText
        android:id="@+id/etStudentName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Nom de l'utilisateur"
        android:inputType="textPersonName"
        android:singleLine="true" />

    <CheckBox
        android:id="@+id/cbRemember"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Se souvenir de moi"
        android:textColor="#28543C" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connexion"
        android:textColor="#FFFFFF"
        android:backgroundTint="#28543C" />

</LinearLayout>
